# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycache

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Environment & secrets ──────────────────────────────────────────────────────
.env
.env.*

# ── Git & IDE ──────────────────────────────────────────────────────────────────
.git/
.gitignore
.dockerignore
.vscode/
.idea/

# ── Docs & markdown ───────────────────────────────────────────────────────────
*.md
*.rst
*.txt
!requirements*.txt

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Local DB & Celery state ───────────────────────────────────────────────────
*.sqlite3
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# ── Heavy data — NEVER in build context ───────────────────────────────────────
# ChromaDB local vector store (7.3 GB) — Docker uses HTTP ChromaDB container
chroma_db/
**/chroma_db/

# Uploaded PDFs (29 MB) — served from volume mount, not baked into image
media/
**/media/

# Collected static files — regenerated by collectstatic at container startup
staticfiles/
**/staticfiles/

# ── Test & CI ─────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.cover

# ── Postman ───────────────────────────────────────────────────────────────────
postman/
.postman/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
